# Copy to .env and set real values before running in shared or production environments.
APP_HOST=0.0.0.0
APP_PORT=8080
APP_RELOAD=false
APP_EXPOSE=false
APP_HTTPS=false
# Comma-separated allowed web origins for browser requests with credentials.
# Examples: https://plexus.example.com,https://admin.example.com
# The /ws/* sockets accept a browser page of the site's own host or of an
# origin listed here; a page served from any other host is refused.
APP_CORS_ORIGINS=http://localhost:8080,http://127.0.0.1:8080
# Enable HSTS header. Defaults to the value of APP_HTTPS when omitted.
APP_HSTS=true
# HSTS max-age in seconds (1 year default).
APP_HSTS_MAX_AGE=31536000
# Redirect plaintext HTTP requests to HTTPS at the app level.
# Detects scheme via X-Forwarded-Proto (reverse proxy) or request URL scheme (direct TLS).
# Defaults to the value of APP_HTTPS when omitted. /api/health is exempt for load-balancer probes.
APP_HTTPS_REDIRECT=true
# API rate limiting - per-IP sliding-window throttle for all API endpoints
# (login has its own brute-force protection separate from this).
APP_API_RATE_LIMIT_ENABLED=true
APP_API_RATE_LIMIT_WINDOW=60
APP_API_RATE_LIMIT_MAX_READ=120
APP_API_RATE_LIMIT_MAX_WRITE=40
APP_REQUIRE_API_TOKEN=false
# Static server API token, empty (disabled) by default. Set it only when
# automation or a federation peer needs it: a request carrying it (X-API-Token
# or Authorization: Bearer) acts as an admin and skips CSRF, the per-IP API
# rate limit and the session limits. deploy/setup.sh generates one only with
# --with-api-token or PLEXUS_ENABLE_API_TOKEN=true.
APP_API_TOKEN=
# Set to true to allow public self-registration via /api/auth/register.
APP_ALLOW_SELF_REGISTER=false
# Database backend. postgres is the only supported value; any other value stops
# the app at startup (migrate a legacy SQLite install with
# tools/migrate_sqlite_to_postgres.py, see docs/database-backends.md).
APP_DB_ENGINE=postgres
# Postgres connection string. Compose uses the host `postgres` (the compose
# network name); when running from source against the dev container use
# 127.0.0.1 (scripts/dev-env.ps1 / scripts/dev-env.sh build it from .env).
APP_DATABASE_URL=postgresql://plexus:plexus@postgres:5432/plexus
POSTGRES_DB=plexus
POSTGRES_USER=plexus
POSTGRES_PASSWORD=change_me
# Postgres server memory and planner settings (docker-compose.yml passes them
# to the postgres container; uncomment to override). The defaults suit the
# container's 2g memory limit: shared_buffers about a quarter of it,
# effective_cache_size about half. random_page_cost 1.1 assumes SSD storage.
# POSTGRES_SHARED_BUFFERS=512MB
# POSTGRES_EFFECTIVE_CACHE_SIZE=1GB
# POSTGRES_WORK_MEM=8MB
# POSTGRES_MAINTENANCE_WORK_MEM=128MB
# POSTGRES_MAX_WAL_SIZE=2GB
# POSTGRES_RANDOM_PAGE_COST=1.1
# App database connection pool (routes/database.py). It serves the monitoring
# polls (16 at once), the collectors and every request. Keep its maximum below
# Postgres's max_connections (default 100); it is clamped to 1-80.
# APP_DB_POOL_MAX=30
# APP_DB_POOL_MIN=2
# Seconds to wait for a free pooled connection before the request fails.
# APP_DB_POOL_ACQUIRE_TIMEOUT=30
# Prepared statements cached per connection (0 turns the cache off).
# APP_DB_STATEMENT_CACHE_SIZE=500
# Seconds a user's account, features and inventory-group grants are reused
# between requests (0-300; 0 turns the cache off). Changes made in Plexus
# apply on the next request; this bounds only edits made straight in the database.
# APP_AUTHZ_CACHE_TTL=20
# Maximum jobs that may run at once.
APP_MAX_CONCURRENT_JOBS=4
# On SIGTERM, how long to let in-flight jobs finish before the process exits
# (seconds). Keep below the container's stop_grace_period (compose: 30s).
APP_SHUTDOWN_JOB_GRACE_SECONDS=15
# Maximum devices processed concurrently inside each Python playbook job.
APP_PLAYBOOK_HOST_CONCURRENCY=5
# Fan-out cap for bulk device CLI/SSH operations (config backups, drift
# checks, compliance scans, deployments, MAC collection, risk analysis).
APP_DEVICE_OP_CONCURRENCY=4
# Job log persistence is batched so verbose jobs do not commit every line.
APP_JOB_EVENT_BATCH_SIZE=50
APP_JOB_EVENT_FLUSH_SECONDS=0.1
# NetFlow / sFlow / IPFIX collector - disabled by default. When enabled, the
# app opens a UDP listener on APP_NETFLOW_PORT for NetFlow v5 + v9/IPFIX.
# Ensure docker-compose exposes the port (already mapped: 2055/udp, 6343/udp)
# and DOCKER-USER/UFW rules permit the exporter source CIDRs - see
# deploy/DEPLOYMENT.md.
APP_NETFLOW_ENABLED=false
APP_NETFLOW_PORT=2055
APP_SFLOW_PORT=6343
# Retention for raw flow_records rows (hours). Older rows are pruned by the
# hourly flow upkeep cycle; the flow views read these rows.
APP_FLOW_RETENTION_HOURS=48
# How often to run the aggregation + retention cycle (seconds). Minimum 60.
APP_FLOW_AGGREGATION_INTERVAL_SECONDS=3600
# Optional Top Talkers ASN labels. Docker already points at the shared GeoIP
# volume. To activate the updater, configure state/geoip/GeoIP.conf first;
# see the "NetFlow network labels" section in deploy/DEPLOYMENT.md.
# COMPOSE_PROFILES=geoip
# Non-Docker: point to a locally maintained database; unset keeps IP-only labels.
# APP_FLOW_ASN_DB=/usr/share/GeoIP/GeoLite2-ASN.mmdb

# ── Security-relevant toggles ────────────────────────────────────────────────
# Expose the OpenAPI docs (/docs, /redoc, /openapi.json). Disabled by default
# so the full API schema isn't public; enable only in trusted environments.
APP_ENABLE_DOCS=false
# SSRF guard override. Empty = enforce the built-in reserved/link-local/
# loopback/metadata blocklist on all outbound requests (SIEM forwarder,
# webhooks, federation, IPAM/DHCP adapters, cloud pullers). Set to a
# comma-separated host/CIDR allowlist ONLY to permit specific internal
# targets - leaving it empty is the safe default.
APP_SSRF_ALLOW=
# Federation: require https:// for peer URLs (the peer API token is admin-
# equivalent and travels as a header). Set true only for isolated lab nets.
PLEXUS_FEDERATION_ALLOW_HTTP=false
# Max software-image upload size in MiB. nginx allows 2100m on
# /api/upgrades/images (deploy/nginx.conf); raise that too if you go higher.
PLEXUS_MAX_IMAGE_UPLOAD_MB=2048
# Largest request body (MiB) accepted outside the upload routes; larger ones
# get 413 before auth runs. Matches nginx's server-level client_max_body_size
# (10m). The upload routes have their own limits (netcontrol/body_limit.py).
APP_MAX_REQUEST_BODY_MB=10
# Compose only: the internal network's subnet and nginx's fixed address on
# it. The app trusts X-Forwarded-For from that address only. Change both if
# the subnet clashes with a host network.
PLEXUS_NETWORK_SUBNET=172.30.80.0/24
PLEXUS_NGINX_IP=172.30.80.10
# Directory for uploaded floor-plan images. In Docker, point this at the
# persistent state volume (compose sets /app/state/floor_plans) - the code
# default (<repo>/floor_plans) is lost on container recreate.
GEO_FLOOR_PLAN_DIR=

# ── First-boot admin bootstrap ───────────────────────────────────────────────
# On first boot with no users, an 'admin' account is created with the
# password 'netcontrol', or PLEXUS_INITIAL_ADMIN_PASSWORD when set, and must
# be changed at first login. PLEXUS_DEV_BOOTSTRAP skips that forced change
# and MUST stay false in production. PLEXUS_FORCE_ADMIN_PASSWORD_RESET resets
# the admin password to the bootstrap one at the next start.
PLEXUS_INITIAL_ADMIN_USERNAME=admin
PLEXUS_INITIAL_ADMIN_PASSWORD=
PLEXUS_DEV_BOOTSTRAP=false
PLEXUS_FORCE_ADMIN_PASSWORD_RESET=false
# Break-glass: a local admin signs in with the local password whatever the
# auth provider is, so a broken RADIUS/TACACS+/LDAP/SSO setup cannot lock
# everyone out. That password is outside the directory's lockout and MFA.
# Set to false to turn the path off (docs/administration.md).
#PLEXUS_BREAKGLASS_LOCAL_ADMIN=true
