# Version control
.git
.gitignore

# Python
.venv/
# Alternate venv name; never needed in the image
venv/
__pycache__/
*.pyc
*.pyo
.mypy_cache/
.ruff_cache/
.pytest_cache/
.coverage
coverage.json
htmlcov/

# Environment and secrets
.env
*.key
*.pem
certs/

# Databases
*.db
*.sqlite3

# Software images (NOS/firmware blobs, often 700MB-1GB+ each).
# Bind-mounted at runtime via docker-compose (./software_images ->
# /app/state/software_images); must never be baked into image layers or the
# layer export fills the container runtime's data-root.
software_images/

# Host-side runtime state: deploy/upgrade.sh keeps pre-upgrade database
# snapshots and the rollback pointer under state/. Those dumps hold password
# hashes and encrypted device credentials and must not end up in a layer.
state/

# Frontend build inputs/outputs. The Dockerfile's node stage runs npm ci +
# npm run build itself.
# Host node_modules (possibly Windows-native binaries) would overwrite the
# stage's Linux install when the source is copied in after npm ci.
netcontrol/static/frontend/node_modules/
# Stale local bundle; the image gets a fresh dist from the node stage.
netcontrol/static/frontend/dist/

# IDE and editor
.vscode/
.idea/
*.swp
*.swo

# CI/CD and docs
.github/
*.md
LICENSE

# Dev tooling
.pre-commit-config.yaml
mypy.ini
pytest.ini
requirements-dev.txt
check_syntax.py

# OS artifacts
Thumbs.db
.DS_Store

# Deploy scripts (not needed inside container; entrypoint is copied at build time)
deploy/*
!deploy/docker-entrypoint.sh
