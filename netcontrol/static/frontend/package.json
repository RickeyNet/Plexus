{
  "name": "plexus-frontend",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Plexus React frontend. Builds to dist/ which FastAPI serves from the site root.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build && vite build -c vite.viewer.config.ts",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "audit:gate": "node scripts/audit-gate.mjs --audit-level=high"
  },
  "dependencies": {
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/lang-yaml": "^6.1.3",
    "@tanstack/react-query": "^5.107.1",
    "@tanstack/react-virtual": "^3.14.26",
    "@uiw/codemirror-theme-dracula": "^4.25.12",
    "@uiw/react-codemirror": "^4.25.12",
    "echarts": "^6.1.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^8.5.1",
    "vis-data": "^8.0.6",
    "vis-network": "^10.1.5"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "eslint": "10.15.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.8",
    "globals": "17.14.0",
    "typescript": "^7.0.2",
    "typescript-eslint": "8.73.0",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  }
}
