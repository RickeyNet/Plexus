{
  "name": "plexus-frontend",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Plexus React frontend. Builds to dist/ which FastAPI serves at /frontend/.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run"
  },
  "dependencies": {
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/lang-yaml": "^6.1.3",
    "@tanstack/react-query": "^5.102.3",
    "@tanstack/react-virtual": "^3.14.10",
    "@uiw/codemirror-theme-dracula": "^4.25.11",
    "@uiw/react-codemirror": "^4.25.11",
    "echarts": "^6.1.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router": "^8.3.0",
    "vis-data": "^8.0.5",
    "vis-network": "^10.1.2"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "^26.3.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^6.1.0",
    "eslint": "10.9.1",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.4",
    "globals": "17.11.0",
    "typescript": "^7.0.2",
    "typescript-eslint": "8.68.0",
    "vite": "^8.2.2",
    "vitest": "4.1.11"
  }
}
